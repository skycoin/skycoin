package skydexui

// copyButton follows CopyButton.jsx. skydex.js copies, also over plain http.
templ copyButton(text, label string) {
	<button type="button" class="btn btn-sm" data-copy={ text } data-label={ label } disabled?={ text == "" } title="Copy to clipboard">{ label }</button>
}

// qrButton follows QrButton.jsx: it opens the QR dialog for address, with a
// payment URI carrying the amount when the coin has a known scheme.
templ qrButton(address string, amount float64, coin, title, hint string) {
	if address != "" {
		<button
			type="button"
			class="btn btn-sm qr-btn"
			title="Show QR code"
			aria-label="Show QR code"
			data-qr={ address }
			data-qr-link={ buildURI(address, amount, coin) }
			data-qr-amount={ amountText(amount, coin) }
			data-qr-coin={ coin }
			data-qr-title={ title }
			data-qr-hint={ hint }
		>
			<svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
				<path fill="currentColor" d="M0 0h7v7H0V0zm2 2v3h3V2H2zM0 9h7v7H0V9zm2 2v3h3v-3H2zM9 0h7v7H9V0zm2 2v3h3V2h-3zM9 9h2v2H9V9zm5 0h2v2h-2V9zm-3 3h2v2h-2v-2zm3 0h2v4h-4v-2h2v-2z"></path>
			</svg>
		</button>
	}
}

// qrDialog is the one QR dialog every qrButton opens. The code stays dark on
// white, as inverted codes scan badly.
templ qrDialog() {
	<dialog id="qr-dialog" class="qr-modal" aria-labelledby="qr-title" data-qr-script={ Asset("qrcode.min.js") }>
		<div class="deposit-head">
			<h4 class="panel-title mb-0" id="qr-title"></h4>
			<button type="button" class="deposit-close" data-qr-close aria-label="Close">✕</button>
		</div>
		<p class="qr-amount mb-2" id="qr-amount">Send exactly <strong></strong></p>
		<div class="qr-canvas" id="qr-canvas"></div>
		<div class="form-check qr-toggle" id="qr-toggle-row">
			<input class="form-check-input" type="checkbox" id="qr-toggle" checked/>
			<label class="form-check-label" for="qr-toggle">Include amount in QR (<span id="qr-coin"></span> payment link)</label>
		</div>
		<div class="qr-addr"><code class="addr-box" id="qr-address"></code></div>
		<div class="copy-row qr-actions">
			<button type="button" class="btn btn-sm" id="qr-copy-address" data-copy="" data-label="Copy address">Copy address</button>
			<button type="button" class="btn btn-sm" id="qr-copy-uri" data-copy="" data-label="Copy payment link">Copy payment link</button>
		</div>
		<p class="hint mt-2 mb-0" id="qr-hint"></p>
	</dialog>
}

// localTime shows an RFC 3339 time in the browser's zone, as the React client
// does with toLocaleTimeString or toLocaleString.
templ localTime(ts string, withDate bool) {
	if withDate {
		<time datetime={ ts } data-local-time="datetime">{ ts }</time>
	} else {
		<time datetime={ ts } data-local-time="time">{ ts }</time>
	}
}
