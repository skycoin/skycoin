{
  "name": "desktopwallet",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/stage-wasm.js",
    "start": "NODE_OPTIONS=--openssl-legacy-provider ng serve --proxy-config proxy.config.js --delete-output-path false --host 0.0.0.0",
    "prestart-local": "node scripts/stage-wasm.js",
    "start-local": "NODE_OPTIONS=--openssl-legacy-provider ng serve --proxy-config proxy.config.js --delete-output-path false --host 0.0.0.0 --environment local",
    "prebuild": "node scripts/stage-wasm.js",
    "build": "ng build --configuration production",
    "prebuild-dev": "node scripts/stage-wasm.js",
    "build-dev": "NODE_OPTIONS=--openssl-legacy-provider ng build",
    "lint": "ng lint",
    "pretest": "node scripts/stage-cipher-fixtures.js && node scripts/stage-wasm.js",
    "test": "ng test --watch=false --browsers ChromeHeadlessNoSandbox",
    "precipher-test": "node scripts/stage-cipher-fixtures.js && node scripts/stage-wasm.js",
    "cipher-test": "ng test --watch=false --browsers ChromeHeadlessNoSandbox --browserNoActivityTimeout=180000 --cipher",
    "pretest:watch": "node scripts/stage-cipher-fixtures.js && node scripts/stage-wasm.js",
    "test:watch": "ng test --browsers Chrome",
    "prestart-docker": "node scripts/stage-wasm.js",
    "start-docker": "ng serve --proxy-config docker-proxy.config.js --delete-output-path false"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.1",
    "@angular/cdk": "^22.1.1",
    "@angular/common": "^22.1.1",
    "@angular/compiler": "^22.1.1",
    "@angular/core": "^22.1.1",
    "@angular/forms": "^22.1.1",
    "@angular/material": "^22.1.1",
    "@angular/platform-browser": "^22.1.1",
    "@angular/platform-browser-dynamic": "^22.1.1",
    "@angular/router": "^22.1.1",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "@popperjs/core": "^2.11.8",
    "axios": "^1.19.0",
    "bignumber.js": "^11.1.5",
    "bip39": "^3.1.0",
    "bootstrap": "^5.3.8",
    "buffer": "^6.0.3",
    "font-awesome": "^4.7.0",
    "hono": "^4.13.1",
    "immutable": "^5.1.9",
    "js-yaml": "^5.2.3",
    "lodash": "^4.18.1",
    "moment": "^2.30.1",
    "rxjs": "^7.8.2",
    "svgo": "^4.0.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.1.0",
    "@angular-eslint/eslint-plugin": "^22.1.0",
    "@angular-eslint/eslint-plugin-template": "^22.1.0",
    "@angular-eslint/template-parser": "^22.1.0",
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.1",
    "@angular/language-service": "^22.1.1",
    "@eslint/js": "^10.0.1",
    "@types/jasmine": "~6.0.0",
    "@types/jasminewd2": "~2.0.13",
    "@types/node": "~26.2.0",
    "angular-eslint": "^22.1.0",
    "eslint": "^10.8.1",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~6.3.0",
    "jasmine-spec-reporter": "~7.0.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-cli": "~2.0.0",
    "karma-coverage-istanbul-reporter": "^3.0.3",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.2.0",
    "process": "^0.11.10",
    "sass": "^1.102.0",
    "sass-loader": "^17.0.0",
    "ts-node": "~10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
