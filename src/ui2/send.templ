package ui2

import (
	"context"
	"strings"
)

// SendPage is the send form of one wallet. With From set it moves every coin
// of that address to an unused receive address of the same wallet.
templ SendPage(s Send) {
	@Layout(T(ctx, "send.title"), "wallets") {
		<div class="page-head">
			<a class="icon-btn" href={ templ.URL(walletURL(s.ID)) } aria-label={ T(ctx, "nav.wallets") }><span class="mi">arrow_back</span></a>
			<h1>{ sendTitle(ctx, s) }</h1>
			if s.Label != "" {
				<span class="badge">{ s.Label }</span>
			}
		</div>
		<section class="card">
			@ErrorBox(s.Err)
			if s.Label != "" {
				<p class="dim">{ T(ctx, "send.available") } <strong>@Money(s.Balance)</strong> { T(ctx, "balance.coins") }</p>
				<form id="send" class="form" hx-post="send/review" hx-target="#review" hx-swap="innerHTML show:#review:top" hx-disabled-elt="find button" autocomplete="off">
					<input type="hidden" name="id" value={ s.ID }/>
					if s.From != "" {
						<input type="hidden" name="from" value={ s.From }/>
						<div class="alert warn">
							<p>{ T(ctx, "send.move-help") }</p>
							<p class="mono">{ s.From }</p>
							<p>{ T(ctx, "send.move-amount", "coins", s.FromCoins) }</p>
						</div>
					} else {
						<fieldset>
							<legend>{ T(ctx, "send.destinations") }</legend>
							<div id="send-rows">
								@sendRow(true)
							</div>
							<div class="bar">
								<button class="btn sm" type="button" hx-get="send/row" hx-target="#send-rows" hx-swap="beforeend"><span class="mi">add</span>{ T(ctx, "send.add-destination") }</button>
								<button class="btn sm" type="button" data-fill-all={ s.Available } title={ T(ctx, "send.all-help") }>{ T(ctx, "send.all") }</button>
							</div>
						</fieldset>
						<label>
							{ T(ctx, "send.note") }
							<input name="note" id="send-note" maxlength="64" autocomplete="off"/>
						</label>
						<p class="small dim">{ T(ctx, "send.note-help") }</p>
						<details class="fold">
							<summary>{ T(ctx, "send.advanced-options") }</summary>
							<label>
								{ T(ctx, "send.change") }
								<input name="change" class="mono" spellcheck="false" autocapitalize="off" placeholder={ T(ctx, "send.change-default") }/>
							</label>
							<p class="small dim">{ T(ctx, "send.change-help") }</p>
							<fieldset>
								<legend>{ T(ctx, "send.hours") }</legend>
								<label class="check"><input type="radio" name="hours_mode" value="auto" checked/>{ T(ctx, "send.hours-auto") }</label>
								<label>
									{ T(ctx, "send.share") }
									<input name="share" type="number" min="0" max="1" step="0.01" value="0.5"/>
								</label>
								<label class="check"><input type="radio" name="hours_mode" value="manual"/>{ T(ctx, "send.hours-manual") }</label>
							</fieldset>
							if len(s.Addrs) > 0 {
								<fieldset>
									<legend>{ T(ctx, "send.from-addresses") }</legend>
									<p class="small dim">{ T(ctx, "send.from-help") }</p>
									for _, a := range s.Addrs {
										<label class="check out-pick">
											<input type="checkbox" name="from_addr" value={ a.Address }/>
											<span><span class="mono small">{ a.Address }</span><span class="small dim">{ a.Coins } · { a.Hours } { T(ctx, "balance.hours") }</span></span>
										</label>
									}
								</fieldset>
							}
							if len(s.Outputs) > 0 {
								<fieldset>
									<legend>{ T(ctx, "send.from-outputs") }</legend>
									<p class="small dim">{ T(ctx, "send.outputs-help") }</p>
									for _, o := range s.Outputs {
										<label class="check out-pick">
											<input type="checkbox" name="from_out" value={ o.Hash }/>
											<span><span class="mono small">{ o.Hash }</span><span class="small dim">{ o.Address } · { o.Coins } · { o.Hours } { T(ctx, "balance.hours") }</span></span>
										</label>
									}
								</fieldset>
							}
							<label>
								{ T(ctx, "send.bulk") }
								<textarea name="bulk" class="mono" rows="4" spellcheck="false" autocapitalize="off" placeholder="address,10&#10;address,2.5"></textarea>
							</label>
							<p class="small dim">{ T(ctx, "send.bulk-help") }</p>
						</details>
					}
					if s.Encrypted {
						<label>
							{ T(ctx, "send.password") }
							<input type="password" name="password" autocomplete="current-password"/>
						</label>
					}
					<div class="bar"><button class="btn primary" type="submit">{ T(ctx, "send.review") }</button><button class="btn" type="button" hx-post="send/unsigned" hx-target="#review" hx-swap="innerHTML show:#review:top" title={ T(ctx, "send.unsigned-help") }>{ T(ctx, "send.unsigned") }</button><span class="busy dim small">{ T(ctx, "ui2.working") }</span></div>
				</form>
				<div id="review"></div>
			}
		</section>
	}
}

func sendTitle(ctx context.Context, s Send) string {
	if s.From != "" {
		return T(ctx, "send.move-title")
	}
	return T(ctx, "send.title")
}

// ReviewView shows the signed transaction before it is sent. Its own form
// carries only the transaction, never the password.
templ ReviewView(r Review) {
	if r.Err != "" {
		if strings.HasPrefix(r.Err, "send.") {
			@ErrorBox(T(ctx, r.Err))
		} else {
			@ErrorBox(r.Err)
		}
	} else {
		<div class="card sub">
			<h2>{ T(ctx, "send.review-title") }</h2>
			for _, w := range r.Warnings {
				<div class="alert warn"><p>{ T(ctx, w) }</p></div>
			}
			<dl class="kv">
				@reviewDests(r)
				for _, c := range r.Change {
					<dt>{ T(ctx, "send.change-output") }</dt>
					<dd><span class="mono">{ c.Address }</span> <span class="nowrap">{ c.Coins } · { c.Hours } { T(ctx, "balance.hours") }</span></dd>
				}
				<dt>{ T(ctx, "send.fee") }</dt>
				<dd>{ r.Fee } { T(ctx, "balance.hours") }</dd>
				<dt>{ T(ctx, "tx.id") }</dt>
				<dd class="mono small">{ r.Txid }</dd>
			</dl>
			<form hx-post="send/inject" hx-target="#review" hx-swap="innerHTML show:#review:top" hx-disabled-elt="find button">
				<input type="hidden" name="id" value={ r.ID }/>
				<input type="hidden" name="rawtx" value={ r.Raw }/>
				<div class="bar">
					<button class="btn primary" type="submit"><span class="mi">send</span>{ T(ctx, "send.send") }</button>
					<button class="btn" type="button" data-clear="#review">{ T(ctx, "send.cancel") }</button>
					<span class="busy dim small">{ T(ctx, "ui2.working") }</span>
				</div>
			</form>
		</div>
	}
}

// SentView confirms the node took the transaction.
templ SentView(back, txid, err string) {
	if err != "" {
		@ErrorBox(err)
	} else {
		<div class="alert ok">
			<p><strong>{ T(ctx, "send.sent") }</strong></p>
			<p class="mono small" data-sent-txid={ txid }>{ txid }</p>
			<p><a class="btn primary" href={ templ.URL(back) }>{ T(ctx, "send.back") }</a></p>
		</div>
	}
}

// UnsignedView is a transaction made without signatures, to sign on
// another machine or by another wallet and broadcast later.
templ UnsignedView(r Review) {
	if r.Err != "" {
		@ErrorBox(T(ctx, r.Err))
	} else {
		<div class="card sub">
			<h2>{ T(ctx, "send.unsigned-title") }</h2>
			for _, w := range r.Warnings {
				<div class="alert warn"><p>{ T(ctx, w) }</p></div>
			}
			<dl class="kv">
				@reviewDests(r)
				<dt>{ T(ctx, "send.fee") }</dt>
				<dd>{ r.Fee } { T(ctx, "balance.hours") }</dd>
			</dl>
			<label class="raw">
				{ T(ctx, "tx.raw") }
				<textarea class="mono" rows="4" readonly>{ r.Raw }</textarea>
			</label>
			<div class="bar">
				<button class="btn sm" type="button" data-copy={ r.Raw }><span class="mi">content_copy</span>{ T(ctx, "tx.copy") }</button>
				<a class="btn sm primary" href={ templ.URL(txPageURL(r.ID, r.Raw)) }>{ T(ctx, "send.unsigned-open") }</a>
			</div>
		</div>
	}
}

// SendRow is one more destination of the send form.
templ SendRow() {
	@sendRow(false)
}

templ sendRow(_ bool) {
	<div class="send-row">
		<input name="to" class="mono" placeholder={ T(ctx, "send.to") } aria-label={ T(ctx, "send.to") } spellcheck="false" autocapitalize="off"/>
		<input name="coins" inputmode="decimal" placeholder={ T(ctx, "send.coins") } aria-label={ T(ctx, "send.coins") }/>
		<input name="hours" inputmode="numeric" placeholder={ T(ctx, "send.row-hours") } aria-label={ T(ctx, "send.row-hours") }/>
	</div>
}

// reviewDests lists what each destination gets.
templ reviewDests(r Review) {
	for _, d := range r.Dests {
		<dt>{ T(ctx, "send.to") }</dt>
		<dd><span class="mono">{ d.To }</span> <span class="nowrap"><strong>{ d.Coins }</strong> · { d.Hours } { T(ctx, "balance.hours") }</span></dd>
	}
}
